__pycache__/
*.pyc
.ipynb_checkpoints/
desktop.ini
Thumbs.db
~$*

# Vendor IP guard (constitution P0): never track vendor assemblies, archives,
# license files, or the vendor directory. The SolarWaveRK/ working copy is the
# user's licensed installation copy and must never re-enter version control.
SolarWaveRK/
*.dll
*.zip
*.7z
research/scalping_lab/substrate/raw/
research/scalping_lab/substrate/minute/

# Raw NT8 tick-probe exports >100MB (GitHub hard limit). Kept ON DISK ONLY - never
# delete; re-derivable from the NT8 data store. Derived substrates (grid1s/sechilo
# parquet) ARE committed.
research/scalping_lab/runs/EXPORT01/*/probe_ticks.csv
research/scalping_lab/runs/DATAPROBE01/*/probe_ticks.csv

# crash dumps from MSYS tooling
*.stackdump

# P0: the per-bar NinjaScript reference export is 58 MB and regenerable from
# research/weekly_edge/src/export_xm_reference.py — the DECISION-level file is committed instead.
research/weekly_edge/ninjascript/reference/xm_reference_bars.csv

# P0/OPERATIONAL RESET 2026-08-27: the NinjaScript per-bar decision ledgers are 200MB+ for a
# 1.62M-bar window and are fully regenerable from the run's own spec.yaml (strategy + ExportDir +
# Analyzer settings are all recorded there). The committed artifact is the per-SESSION reduction.
runs/WE_XM_PARITY_20260827/out/we_xm_*.csv
runs/*/out/we_p1pct_*.csv

# microstructure substrate v2: parquet is large binary research data, kept on disk not in git
research/data_microstructure_v2/raw/
research/data_internals/*.parquet
runs/INTERNALS_ACQUIRE_20260827/out/csv/
runs/MULTIMARKET_INVENTORY_20260827/out/csv/*_bars.csv

# MS-LAST discovery substrate (regenerable from src/substrate.py; large)
runs/MSLAST_CONTRACT_20260827/out/discovery_substrate.parquet
runs/MSLAST_CONTRACT_20260827/out/cost_sample.csv
research/multi_market/export/
research/multi_market/out/economic_returns.parquet

# ESNQ_V1 raw tick exports - on disk only, regenerable from the NT8 store.
# MANIFEST + QA are committed; the multi-GB parquet/csv are not.
research/data_esnq/raw/
research/data_esnq/parquet/

# GENESIS free-data raw quarantine - contains post-seal rows (never inspected);
# sha256-manifested; certified/ (pre-seal only) IS committed.
runs/GENESIS_FREEDATA_CBOE_20260828/raw/*
!runs/GENESIS_FREEDATA_CBOE_20260828/raw/_MANIFEST.json

# ABS-vs-PCT raw NT8 backtest payloads (multi-MB, regenerable from the run spec;
# the derived trade lists and weekly series ARE committed).
runs/G2_ABS_VS_PCT_20260830/out/nt8_raw_*.json

# GENESIS III executable-object parity: the 32 MB snapshot of the live strategy's own per-bar
# export and the 24 MB joined per-bar comparison. KEPT ON DISK, NEVER DELETED - the snapshot is
# NOT regenerable (the live file is appended to continuously), so its sha256 is recorded in
# out/gates.json and that hash is the citable object. out/disagreements.csv IS committed: it is
# the audit trail for gates that FAILED, and failed-gate evidence stays in version control.
runs/G3_EXECTRUTH_01_20260831/out/cs_export_snapshot.csv
runs/G3_EXECTRUTH_01_20260831/out/parity_bars.csv

# G3_SHORTALPHA decay sub-wave: the vendor member-target caches are 6.3 MB each and are
# byte-regenerable from run_we_w01.sm14_1m for the same bar count (the cache key is the bar
# count + close checksum). The trade ledgers and session frames they produce ARE committed.
runs/G3_SHORTALPHA_20260831/out/_decay_cache/tg_*.npy
